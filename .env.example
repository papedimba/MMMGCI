APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_TEST_NAME=
MAIL_FROM=
MAIL_DRIVER=mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SESSION_IDLE_MINUTES=30
UPLOAD_MAX_MB=5
